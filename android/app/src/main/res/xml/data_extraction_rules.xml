<?xml version="1.0" encoding="utf-8"?>
<!-- Phone backups never carry the journal (ADR 0011): cloud users restore from
     their cloud, everyone else from a Cairn backup file. Nothing else the app
     keeps is worth restoring, so nothing is backed up or transferred.

     The account master key travels separately, through Block Store (ADR 0012).
     Backup stays allowed in the manifest because Block Store is built on the
     same backup service. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
